{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AK Studio",
  "version": "0.1.0",
  "identifier": "com.holmesfems.akstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AK Studio",
        "width": 1680,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 720,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
